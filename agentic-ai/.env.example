GEMINI_API_KEY=
# Set a Gemini model ID available to your account.
GEMINI_MODEL=
ASPNET_API_BASE_URL=http://localhost:5000
AI_TIMEOUT_SECONDS=10
AI_MAX_ATTEMPTS=2
# Total seconds per Gemini call, including attempts, backoff and shared 429 cooldown.
AI_CALL_BUDGET_SECONDS=35
ASPNET_TIMEOUT_SECONDS=10
# Set the same random secret (at least 32 characters) in both service environments.
# Placeholder only; an empty token disables internal execution.
INTERNAL_WORKFLOW_TOKEN=
WORKFLOW_TIMEOUT_SECONDS=120
